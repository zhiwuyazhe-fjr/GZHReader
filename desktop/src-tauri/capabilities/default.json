{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "GZHReader desktop permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/gzhreader-core",
          "sidecar": true
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "notification:default",
    "autostart:default",
    "updater:default",
    "process:default"
  ]
}
